/* WParted Windows resources (generated by CMake from wparted.rc.in) */
#include <windows.h>

/* Application icon (first icon resource is used by Explorer) */
1 ICON "wparted.ico"

/* Application manifest: administrator rights, Windows 10/11, DPI and long paths */
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "wparted.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "Issen Software Group\0"
			VALUE "FileDescription",  "WParted - Windows Partition Editor\0"
			VALUE "FileVersion",      "@PROJECT_VERSION@\0"
			VALUE "InternalName",     "wparted\0"
			VALUE "LegalCopyright",   "Copyright (C) 2004-2026 the GParted authors; Windows port (C) 2026 Juan E. Gallego T. (Issen Software Group) and WParted contributors.  GNU GPL v2 or later.\0"
			VALUE "OriginalFilename", "wparted.exe\0"
			VALUE "ProductName",      "WParted\0"
			VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
			VALUE "Comments",         "A Windows port of GParted, the GNOME Partition Editor\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
